<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.smartenergymanager.controller.ConsommationsController"
            stylesheets="@../css/styles.css, @../css/batiments-view.css, @../css/consommations-view.css">

    <!-- ── Barre d'outils ── -->
    <top>
        <HBox styleClass="toolbar" spacing="8" alignment="CENTER_LEFT">
            <padding>
                <Insets top="12" right="16" bottom="12" left="16"/>
            </padding>

            <Label text="Consommations" styleClass="page-title"/>

            <Separator orientation="VERTICAL" styleClass="toolbar-separator">
                <HBox.margin><Insets left="4" right="4"/></HBox.margin>
            </Separator>

            <!-- Filtre par bâtiment -->
            <Label text="Batiment :" styleClass="filter-label"/>
            <ComboBox fx:id="cbxFiltreBatiment" promptText="Tous les batiments" prefWidth="200"/>

            <Region HBox.hgrow="ALWAYS"/>

            <Button fx:id="btnSaisie"
                    text="+ Saisie manuelle"
                    styleClass="btn-primary"
                    onAction="#ajouterReleve"/>

            <Button fx:id="btnImport"
                    text="Import CSV"
                    styleClass="btn-secondary"
                    onAction="#importerCSV"/>

            <Button fx:id="btnGenerer"
                    text="Generer donnees test"
                    styleClass="btn-secondary"
                    onAction="#genererDonnees"/>

            <Separator orientation="VERTICAL" styleClass="toolbar-separator">
                <HBox.margin><Insets left="4" right="4"/></HBox.margin>
            </Separator>

            <Button fx:id="btnSupprimer"
                    text="Supprimer"
                    styleClass="btn-danger"
                    onAction="#supprimerReleve"/>
        </HBox>
    </top>

    <!-- ── Tableau des relevés ── -->
    <center>
        <TableView fx:id="tblReleves" styleClass="data-table">
            <columns>
                <TableColumn fx:id="colDate"      text="Date"          prefWidth="110"/>
                <TableColumn fx:id="colHeure"     text="Heure"         prefWidth="70"/>
                <TableColumn fx:id="colBatiment"  text="Batiment"      prefWidth="200"/>
                <TableColumn fx:id="colType"      text="Type energie"  prefWidth="150"/>
                <TableColumn fx:id="colQuantite"  text="Quantite"      prefWidth="100"/>
                <TableColumn fx:id="colCout"      text="Cout (euro)"   prefWidth="110"/>
            </columns>
            <placeholder>
                <Label text="Aucun releve. Cliquez sur '+ Saisie manuelle' pour commencer."
                       styleClass="table-placeholder"/>
            </placeholder>
        </TableView>
    </center>

    <!-- ── Barre de statut ── -->
    <bottom>
        <HBox styleClass="status-bar">
            <padding>
                <Insets top="6" right="16" bottom="6" left="16"/>
            </padding>
            <Label fx:id="lblStatut" styleClass="status-label"/>
        </HBox>
    </bottom>

</BorderPane>
